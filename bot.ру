@dp.message(Command("start"))
async def start_command(message: Message):
    register_user(message.from_user)

    user = get_user(message.from_user.id)

    if not user or user[3] != 1:
        await message.answer(
            "⛔ Ваш доступ отключён. Обратитесь к руководителю."
        )
        return

    role = user[2]

    if role in ("owner", "manager"):
        commands = (
            "/new — создать анкету\n"
            "/mine — мои объекты\n"
            "/all — все объекты\n"
            "/stats — статистика\n"
            "/addagent TELEGRAM_ID — добавить агента\n"
            "/addmanager TELEGRAM_ID — назначить руководителя"
        )
    else:
        commands = (
            "/new — создать анкету\n"
            "/mine — мои объекты"
        )

    await message.answer(
        f"👋 Привет, {escape(message.from_user.full_name)}!\n\n"
        "Ты зарегистрирован в DELTA CRM.\n\n"
        f"Доступные команды:\n{commands}"
    )


@dp.message(Command("new"))
async def new_object(message: Message, state: FSMContext):
    if not await check_access(message):
        return

    await state.clear()
    await state.update_data(
        agent_id=message.from_user.id,
        agent_name=message.from_user.full_name,
        created_at=datetime.now().strftime("%d.%m.%Y %H:%M")
    )

    await state.set_state(Form.object_name)
    await message.answer(
        "🏪 <b>Новая анкета DELTA CRM</b>\n\n"
        "1. Введите название торговой точки или вывеску:"
    )


