@dp.callback_query(Form.status, F.data.startswith("choice:"))
async def get_status(callback: CallbackQuery, state: FSMContext):
    try:
        index = int(callback.data.split(":")[1])
        status = STATUSES[index]
    except (ValueError, IndexError):
        await callback.answer("Некорректный выбор", show_alert=True)
        return

    await state.update_data(status=status)

    if status == "HOT":
        await state.set_state(Form.followup)
        question = (
            "🔥 Укажите дату и время замера сигнала техником.\n"
            "Если время ещё не назначено — напишите «Не назначено»."
        )

    elif status == "WARM":
        await state.set_state(Form.followup)
        question = (
            "🟡 Укажите дату и время созвона с директором."
        )

    elif status == "ОТКАЗ":
        await state.set_state(Form.refusal_reason)
        question = "❌ Укажите причину отказа."

    else:
        await save_object(callback.message, state)
        await callback.answer()
        return

    await callback.message.edit_text(question)
    await callback.answer()


