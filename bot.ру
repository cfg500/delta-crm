# ===== БАЗА ДАННЫХ =====

def connect():
    return sqlite3.connect(DB_NAME)


def init_db():
    con = connect()
    cur = con.cursor()

    cur.execute("""
    CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        name TEXT,
        role TEXT DEFAULT 'agent',
        active INTEGER DEFAULT 1
    )
    """)

    cur.execute("""
    CREATE TABLE IF NOT EXISTS objects (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        agent_id INTEGER,
        agent_name TEXT,
        created_at TEXT,
        object_name TEXT,
        address TEXT,
        chop TEXT,
        monthly_fee TEXT,
        equipment TEXT,
        security_type TEXT,
        lpr_name TEXT,
        lpr_phone TEXT,
        extra_contact TEXT,
        status TEXT,
        followup TEXT,
        refusal_reason TEXT
    )
    """)

    cur.execute("""
    CREATE TABLE IF NOT EXISTS logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        action TEXT,
        created_at TEXT
    )
    """)

    cur.execute("""
    INSERT OR IGNORE INTO users
    (user_id, name, role, active)
    VALUES (?, ?, 'owner', 1)
    """, (OWNER_ID, "Главный руководитель"))

    con.commit()
    con.close()


def get_user(user_id):
    con = connect()
    result = con.execute(
        "SELECT user_id, name, role, active FROM users WHERE user_id=?",
        (user_id,)
    ).fetchone()
    con.close()
    return result


def register_user(user):
    con = connect()

    con.execute("""
    INSERT OR IGNORE INTO users
    (user_id, name, role, active)
    VALUES (?, ?, 'agent', 1)
    """, (user.id, user.full_name))

    con.execute("""
    UPDATE users SET name=?
    WHERE user_id=? AND active=1
    """, (user.full_name, user.id))

    con.commit()
    con.close()


def is_active(user_id):
    user = get_user(user_id)
    return bool(user and user[3] == 1)


def is_manager(user_id):
    user = get_user(user_id)
    return bool(
        user and user[3] == 1
        and user[2] in ("owner", "manager")
    )


def log_action(user_id, action):
    con = connect()
    con.execute("""
    INSERT INTO logs (user_id, action, created_at)
    VALUES (?, ?, ?)
    """, (
        user_id,
        action,
        datetime.now().strftime("%d.%m.%Y %H:%M")
    ))
    con.commit()
    con.close()


