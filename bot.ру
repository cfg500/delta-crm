    if not await check_access(message):
        return

    if not is_manager(message.from_user.id):
        await message.answer("⛔ Только для руководителей.")
        return

    parts = message.text.split()

    if len(parts) != 2 or not parts[1].isdigit():
        await message.answer("Формат: /block TELEGRAM_ID")
        return

    target_id = int(parts[1])

    if target_id == OWNER_ID:
        await message.answer("Главного руководителя блокировать нельзя.")
        return

    con = connect()
    con.execute(
        "UPDATE users SET active=0 WHERE user_id=?",
        (target_id,)
    )
    con.commit()
    con.close()

    log_action(message.from_user.id, f"Заблокирован {target_id}")
    await message.answer("🚫 Пользователь заблокирован.")


