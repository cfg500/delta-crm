@dp.message(Command("addmanager"))
async def add_manager(message: Message):
    if not await check_access(message):
        return

    if message.from_user.id != OWNER_ID:
        await message.answer("⛔ Только главный руководитель может назначать руководителей.")
        return

    parts = message.text.split()

    if len(parts) != 2 or not parts[1].isdigit():
        await message.answer(
            "Формат команды:\n/addmanager TELEGRAM_ID"
        )
        return

    target_id = int(parts[1])

    con = connect()
    result = con.execute(
        "SELECT user_id FROM users WHERE user_id=?",
        (target_id,)
    ).fetchone()

    if not result:
        con.close()
        await message.answer(
            "Пользователь ещё не запускал бота. "
            "Попросите его отправить /start и повторите команду."
        )
        return

    con.execute("""
        UPDATE users SET role='manager', active=1
        WHERE user_id=?
    """, (target_id,))

    con.commit()
    con.close()

    log_action(message.from_user.id, f"Назначен руководитель {target_id}")
    await message.answer("✅ Руководитель назначен.")


