# ===== СТАТИСТИКА =====

@dp.message(Command("stats"))
async def stats(message: Message):
    if not await check_access(message):
        return

    if not is_manager(message.from_user.id):
        await message.answer("⛔ Только для руководителей.")
        return

    con = connect()

    total = con.execute(
        "SELECT COUNT(*) FROM objects"
    ).fetchone()[0]

    statuses = con.execute("""
        SELECT status, COUNT(*)
        FROM objects
        GROUP BY status
    """).fetchall()

    agents = con.execute("""
        SELECT COUNT(*) FROM users
        WHERE role='agent' AND active=1
    """).fetchone()[0]

    con.close()

    text = (
        "📊 <b>Статистика DELTA CRM</b>\n\n"
        f"Всего объектов: <b>{total}</b>\n"
        f"Активных агентов: <b>{agents}</b>\n\n"
    )

    for status, count in statuses:
        text += f"{escape(status or '')}: {count}\n"

    await message.answer(text)


