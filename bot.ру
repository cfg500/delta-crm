async def save_object(message: Message, state: FSMContext):
    data = await state.get_data()

    con = connect()
    con.execute("""
        INSERT INTO objects (
            agent_id, agent_name, created_at,
            object_name, address, chop, monthly_fee,
            equipment, security_type, lpr_name,
            lpr_phone, extra_contact, status,
            followup, refusal_reason
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        data["agent_id"],
        data["agent_name"],
        data["created_at"],
        data["object_name"],
        data["address"],
        data["chop"],
        data["monthly_fee"],
        data["equipment"],
        data["security_type"],
        data["lpr_name"],
        data["lpr_phone"],
        data["extra_contact"],
        data["status"],
        data.get("followup", ""),
        data.get("refusal_reason", "")
    ))

    con.commit()
    con.close()

    log_action(data["agent_id"], "Создан объект")
    await state.clear()

    await message.answer(
        "✅ <b>Анкета успешно сохранена!</b>\n\n"
        f"🏪 Объект: {escape(data['object_name'])}\n"
        f"📍 Адрес: {escape(data['address'])}\n"
        f"🛡 ЧОП: {escape(data['chop'])}\n"
        f"💰 Абонентская плата: {escape(data['monthly_fee'])}\n"
        f"🔧 Оборудование: {escape(data['equipment'])}\n"
        f"🚨 Охрана: {escape(data['security_type'])}\n"
        f"👤 ЛПР: {escape(data['lpr_name'])}\n"
        f"📞 Телефон: {escape(data['lpr_phone'])}\n"
        f"📊 Статус: <b>{escape(data['status'])}</b>\n\n"
        "Для следующего объекта используй /new."
    )

    # ===== МОИ ОБЪЕКТЫ =====

@dp.message(Command("mine"))
