def make_keyboard(options):
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text=option,
                    callback_data=f"choice:{index}"
                )
            ]
            for index, option in enumerate(options)
        ]
    )

